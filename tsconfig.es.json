{
    "compilerOptions": {
      "baseUrl": ".",
      "outDir": "es",
      "module": "esnext",
      "target": "es2020",
      "lib": ["es2020", "dom"],
      "sourceMap": true,
      "jsx": "react-jsx",
      "moduleResolution": "node",
      "rootDir": "src/lib",
      "forceConsistentCasingInFileNames": true,
      "noImplicitReturns": true,
      "noImplicitThis": true,
      "noImplicitAny": true,
      "strictNullChecks": true,
      "noUnusedLocals": true,
      "declaration": true
    },
    "include": [
      "./src/lib/**/*.tsx",
      "./src/lib/**/*.ts"
    ],
    "exclude": [
      "node_modules",
      "build",
      "docs",
      "es",
      "lib",
      "scripts",
      "acceptance-tests",
      "webpack",
      "jest",
      "src/setupTests.ts"
    ]
  }
  